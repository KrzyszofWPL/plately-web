# ============================================================================
# plately.eu — environment variables
#
# These are set in the Vercel dashboard (Project → Settings → Environment
# Variables), NOT in a file in the repository. This file only documents what
# each one is for. .gitignore lets .env.example through and blocks .env*.
#
# After adding or changing any of these: Deployments → ⋯ → Redeploy. Vercel
# only hands new values to new deployments.
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase — where every ticket, message and staff row lives
#
# The SAME project the app uses, so a ticket can show the writer's real plan
# and invoices. Run supabase/support-schema.sql there once.
#
# SUPABASE_URL is not on the API Keys page: take it from the Connect dialog,
# from Project Settings -> Data API, or simply build it out of the project ref
# in the dashboard's own address — https://<ref>.supabase.co
#
# SUPABASE_SERVICE_ROLE_KEY accepts either generation of server-side key: the
# legacy `service_role` JWT (starts with eyJ) or a newer `sb_secret_…`. They
# travel in different headers and api/_lib/db.js picks the right one. Never the
# anon or publishable key — those are public and grant nothing here.
#
# Whichever it is, it bypasses Row Level Security, is used only by Edge
# Functions, and must never appear in anything the browser downloads — there is
# deliberately no VITE_/NEXT_PUBLIC_ variant of it here.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role-jwt-or-sb_secret_..."


# ---------------------------------------------------------------------------
# Google sign-in — for /support, and for the "attach my address" button on /help
#
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# → Web application. One client serves both flows; the redirect URI list must
# name every hostname AND every callback path, all four:
#   https://www.plately.eu/api/staff/callback
#   https://plately.eu/api/staff/callback
#   https://www.plately.eu/api/help/callback
#   https://plately.eu/api/help/callback
#
# The /help flow reads the address and nothing else — no account is created and
# no token is stored. A missing entry here shows up as redirect_uri_mismatch.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"


# ---------------------------------------------------------------------------
# Session and PIN secrets
#
# SESSION_SECRET signs the session cookies and the OAuth state. PEPPER is
# mixed into the PIN hash and is what keeps a four-digit PIN safe even if the
# database leaks — it lives here and nowhere else. PEPPER also keys the hashed
# visitor addresses the /help form rate-limits on, so those cannot be reversed
# out of a database dump either.
#
# Generate each one separately, 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing SESSION_SECRET signs everyone out. Changing PEPPER invalidates
# every PIN — they have to be reset by an owner. Neither touches the
# authenticator secrets: those live in the staff table and survive a rotation.
# ---------------------------------------------------------------------------
SESSION_SECRET="64-hex-characters"
PEPPER="64-hex-characters-different-from-the-above"


# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the bot gate on /support and on the /help form
#
# dash.cloudflare.com → Turnstile → Add widget, hostname plately.eu.
# The site key is public (it ships to the browser through /api/staff/session
# and /api/help/session); the secret key is not.
#
# One widget covers both: they are the same hostname. On /support it guards the
# PIN and the authenticator code; on /help it is what stops the public form
# being used to flood the desk.
#
# Leaving these unset does not break either page: the challenge is skipped, and
# on /support Google, the PIN and the authenticator still stand. Set them.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."


# ---------------------------------------------------------------------------
# Resend — the mail channel, both directions
#
# RESEND_API_KEY          resend.com → API Keys (needs Full access: the panel
#                         both sends and reads received mail)
# RESEND_WEBHOOK_SECRET   resend.com → Webhooks → your email.received hook →
#                         Signing Secret ("whsec_…"). Without it the inbound
#                         endpoint refuses everything, by design.
# SUPPORT_MAIL_DOMAIN     used for the Message-ID we generate and to ignore
#                         mail we sent ourselves (no auto-reply loops)
# SUPPORT_FROM_EMAIL      the visible sender; can also be changed in the panel
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
SUPPORT_MAIL_DOMAIN="plately.eu"
SUPPORT_FROM_EMAIL="contact@plately.eu"
SUPPORT_FROM_NAME="Plately Support"
# Optional. While you are learning to trust the desk, every inbound mail is
# also forwarded here as a plain copy — useful right after the MX record moves
# to Resend and the registrar's forwarding to Gmail stops. Each copy costs one
# send from the daily quota; delete the variable once you no longer need it.
# SUPPORT_FORWARD_COPY_TO="you@gmail.com"


# ---------------------------------------------------------------------------
# Maintenance switch (already in use before the support desk existed)
#
# GLOBAL_CONFIG / EDGE_CONFIG is the read connection string; VERCEL_API_TOKEN
# is what lets the panel *write* the mode back. VERCEL_TEAM_ID is required
# when the project belongs to a team rather than a personal account.
# ---------------------------------------------------------------------------
GLOBAL_CONFIG="https://edge-config.vercel.com/ecfg_xxx?token=xxx"
VERCEL_API_TOKEN="vercel-api-token"
VERCEL_TEAM_ID="team_xxx"


# ---------------------------------------------------------------------------
# Legacy break-glass panel at /admin/legacy
#
# The username/password switch that predates Google sign-in. Now reached at
# /support/legacy (the panel moved off /admin). Keep it until the new sign-in
# is proven, then delete these and the page stops working — which is the point.
#
# ADMIN_PASSWORD_HASH is HMAC-SHA256 of the password, keyed with PEPPER:
#   node -e "console.log(require('crypto').createHmac('sha256', process.env.PEPPER).update('your-password').digest('hex'))"
# ---------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="hmac-sha256-of-the-password-keyed-with-PEPPER"
