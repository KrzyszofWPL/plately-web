# ============================================================================
# plately.eu — environment variables
#
# These are set in the Vercel dashboard (Project → Settings → Environment
# Variables), NOT in a file in the repository. This file only documents what
# each one is for. .gitignore lets .env.example through and blocks .env*.
#
# After adding or changing any of these: Deployments → ⋯ → Redeploy. Vercel
# only hands new values to new deployments.
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase — where every ticket, message and staff row lives
#
# The SAME project the app uses, so a ticket can show the writer's real plan
# and invoices. Run supabase/support-schema.sql there once.
#
# SUPABASE_URL is not on the API Keys page: take it from the Connect dialog,
# from Project Settings -> Data API, or simply build it out of the project ref
# in the dashboard's own address — https://<ref>.supabase.co
#
# SUPABASE_SERVICE_ROLE_KEY accepts either generation of server-side key: the
# legacy `service_role` JWT (starts with eyJ) or a newer `sb_secret_…`. They
# travel in different headers and api/_lib/db.js picks the right one. Never the
# anon or publishable key — those are public and grant nothing here.
#
# Whichever it is, it bypasses Row Level Security, is used only by Edge
# Functions, and must never appear in anything the browser downloads — there is
# deliberately no VITE_/NEXT_PUBLIC_ variant of it here.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role-jwt-or-sb_secret_..."


# ---------------------------------------------------------------------------
# Google sign-in — for the two panel doors: /support (the desk, staff) and
# /dietitian (the practice panel). /staff is the older shared entrance and
# still works. One OAuth client serves all three: the callback is the same.
#
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# → Web application. Authorised redirect URIs must name every hostname the
# panel is reached on:
#   https://www.plately.eu/api/staff/callback
#   https://plately.eu/api/staff/callback
#
# The public help form does NOT use Google. It takes a typed address and proves
# it with a confirmation link instead, so nothing here needs to change for it.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"


# ---------------------------------------------------------------------------
# Session and PIN secrets
#
# SESSION_SECRET signs the session cookies and the OAuth state. PEPPER is
# mixed into the PIN hash and is what keeps a four-digit PIN safe even if the
# database leaks — it lives here and nowhere else. PEPPER also keys the hashed
# visitor addresses the /help form rate-limits on, so those cannot be reversed
# out of a database dump either.
#
# Generate each one separately, 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing SESSION_SECRET signs everyone out. Changing PEPPER invalidates
# every PIN — they have to be reset by an owner. Neither touches the
# authenticator secrets: those live in the staff table and survive a rotation.
# ---------------------------------------------------------------------------
SESSION_SECRET="64-hex-characters"
PEPPER="64-hex-characters-different-from-the-above"


# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the bot gate on /support and on the /help form
#
# dash.cloudflare.com → Turnstile → Add widget, hostname plately.eu.
# The site key is public (it ships to the browser through /api/staff/session
# and /api/help/session); the secret key is not.
#
# One widget covers all of it: they are the same hostname. On /staff it guards
# the PIN, the authenticator code and the practice registration form; on /help
# it is what stops the public form being used to flood the desk; and on
# /giftcards/<link> it is the gate on the gift itself — the box only opens for
# a request Cloudflare has vouched for, and a refused request learns nothing
# about whether the card is real. That last page renders the widget invisibly
# (`appearance: interaction-only`), so keep the widget in "Managed" mode: an
# "Invisible" widget works too, a "Non-interactive" one is fine as well.
#
# Leaving these unset does not break any page: the challenge is skipped, and
# on /staff Google, the PIN and the authenticator still stand. But on
# /giftcards it means the gift opens for anybody with the link, bots included,
# with only the per-address limit in the database left. Set them.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."


# ---------------------------------------------------------------------------
# Resend — the mail channel, both directions
#
# RESEND_API_KEY          resend.com → API Keys (needs Full access: the panel
#                         both sends and reads received mail)
# RESEND_WEBHOOK_SECRET   resend.com → Webhooks → your email.received hook →
#                         Signing Secret ("whsec_…"). Without it the inbound
#                         endpoint refuses everything, by design.
# SUPPORT_MAIL_DOMAIN     used for the Message-ID we generate and to ignore
#                         mail we sent ourselves (no auto-reply loops)
# SUPPORT_FROM_EMAIL      the visible sender; can also be changed in the panel
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# --- who each message comes from -------------------------------------------
#
# Two subdomains, three addresses, and the split is on purpose.
#
# Sender reputation is tracked per DOMAIN. The day a "keep your streak going"
# notice gets marked as spam by enough people, it takes info.plately.eu down
# with it — and help.plately.eu, carrying the mail somebody is actually waiting
# for, is untouched. Mixing the two is how a support desk lands in spam because
# of a marketing send it had nothing to do with.
#
# Both are subdomains rather than the apex, which means plately.eu's own MX
# never moves: whatever forwarding the registrar does for contact@plately.eu
# keeps working exactly as it did.
#
#   contact@help.  the conversation. Replies come back here and rejoin the
#                  ticket, which is why it is not the same address as below.
#   noreply@help.  the confirmation link and the auto-acknowledgement.
#   noreply@info.  subscription notices, streak reminders, lifecycle mail.
#
# Each subdomain is a separate "domain" in Resend and needs its own DNS records.
# The free plan allows ONE verified domain (checked September 2026; it used to
# be more). On it, verify help.plately.eu only and point the INFO_* trio at the
# same domain — lifecycle mail then shares the desk's reputation, which is the
# trade-off, not a breakage. The split below is what Pro buys you.
SUPPORT_MAIL_DOMAIN="help.plately.eu"
SUPPORT_FROM_EMAIL="contact@help.plately.eu"
SUPPORT_NOREPLY_EMAIL="noreply@help.plately.eu"
SUPPORT_FROM_NAME="Plately Support"
INFO_MAIL_DOMAIN="info.plately.eu"
INFO_FROM_EMAIL="noreply@info.plately.eu"
INFO_FROM_NAME="Plately"
# Optional. While you are learning to trust the desk, every inbound mail is
# also forwarded here as a plain copy — useful right after the MX record moves
# to Resend and the registrar's forwarding to Gmail stops. Each copy costs one
# send from the daily quota; delete the variable once you no longer need it.
# SUPPORT_FORWARD_COPY_TO="you@gmail.com"


# ---------------------------------------------------------------------------
# Maintenance switch (already in use before the support desk existed)
#
# GLOBAL_CONFIG / EDGE_CONFIG is the read connection string; VERCEL_API_TOKEN
# is what lets the panel *write* the mode back. VERCEL_TEAM_ID is required
# when the project belongs to a team rather than a personal account.
# ---------------------------------------------------------------------------
GLOBAL_CONFIG="https://edge-config.vercel.com/ecfg_xxx?token=xxx"
VERCEL_API_TOKEN="vercel-api-token"
VERCEL_TEAM_ID="team_xxx"


# ---------------------------------------------------------------------------
# Public status page at /status
#
# Nothing here is required. /api/status checks four things live — the site,
# the app, Supabase and Resend — reusing SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# and RESEND_API_KEY from above. A component whose credentials are missing is
# reported as "not measured" rather than as healthy, so a half-configured
# deployment still gets an honest page.
#
# The seven-day history needs supabase/status-schema.sql to have been run. Until
# it has, the page says so and shows only the live checks.
#
# APP_URL   only if the app moves off app.plately.eu. It is fetched as an
#           ordinary visitor would fetch it, so point it at something that
#           answers without a login.
# ---------------------------------------------------------------------------
# APP_URL="https://app.plately.eu/"


# ---------------------------------------------------------------------------
# Legacy break-glass panel at /admin/legacy
#
# The username/password switch that predates Google sign-in. Now reached at
# /support/legacy (the panel moved off /admin). Keep it until the new sign-in
# is proven, then delete these and the page stops working — which is the point.
#
# ADMIN_PASSWORD_HASH is HMAC-SHA256 of the password, keyed with PEPPER:
#   node -e "console.log(require('crypto').createHmac('sha256', process.env.PEPPER).update('your-password').digest('hex'))"
# ---------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="hmac-sha256-of-the-password-keyed-with-PEPPER"


# ---------------------------------------------------------------------------
# The "Use AI" button in the help desk
#
# The same provider and the same key the app already uses — see
# `Application APK/serverless/aiProvider.ts`. Adding a second provider here
# would mean a second key, a second bill and a second thing to disclose in the
# privacy policy, for a feature the existing one answers perfectly well.
#
# GEMINI_API_KEY      aistudio.google.com. Has a free tier. AI_API_KEYS (the
#                     app's comma-separated pool) is accepted too — the first
#                     key in it is used.
# AI_BASE_URL         optional. Set it to an OpenAI-compatible gateway
#                     (OpenRouter and friends) and requests go there instead,
#                     exactly as in the app.
# MODEL_SUPPORT_DRAFT optional. Pinned, never a `-latest` alias: Google
#                     hot-swaps those, and a desk whose answers change tone
#                     overnight without a deploy is a desk nobody can debug.
#
# Leave all three unset and the button simply does not appear. Nothing else
# about the desk changes.
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."
# AI_BASE_URL="https://openrouter.ai/api/v1"
# MODEL_SUPPORT_DRAFT="gemini-3.1-flash-lite"

# ---------------------------------------------------------------------------
# The gift-card shop at /giftcards (api/gift/checkout, /ipn, /order)
#
# Cards are bought WITHOUT an account: the buyer types an e-mail, pays at
# NOWPayments, and gets the gift link on the page and by mail. The same
# provider account the app uses (Application APK: NOWPAYMENTS_API_KEY,
# NOWPAYMENTS_IPN_SECRET) — copy both here. The IPN callback URL is sent
# with every invoice (https://www.plately.eu/api/gift/ipn), so nothing in the
# provider's dashboard has to point here.
#
# Leaving NOWPAYMENTS_API_KEY unset switches the shop off politely: the page
# says payments are not enabled yet. Prices live in api/_lib/gift-shop.js and
# mirror the app's plans.ts — change them there first.
#
# SITE_URL is where the provider sends the buyer back and where the mailed
# gift link points. The apex redirects to www, so the www form is the default.
# ---------------------------------------------------------------------------
NOWPAYMENTS_API_KEY="..."
NOWPAYMENTS_IPN_SECRET="..."
# SITE_URL="https://www.plately.eu"


# === Plately Pro — practice verification (api/practice) ======================
#
# A dietitian registers on /staff and is verified in three steps, in order,
# and NONE OF THEM NEEDS A KEY — every source is a public register or the
# practice's own site:
#
#   1. Domain   — signed in with a mailbox on the practice's domain, or added
#                 a TXT record (DNS-over-HTTPS). Nothing else runs until this
#                 passes.
#   2. Company  — the VAT number, against the Ministry of Finance register for
#                 Polish numbers (wl-api.mf.gov.pl, 100 lookups/day/IP) and
#                 VIES for the rest of the EU.
#   3. Presence — the practice's own website (answers, is about nutrition or
#                 health, names the practice) and the domain's registration
#                 date over RDAP — at least a year old.
#
# All three pass → verified on the spot. Anything short after step one files
# a ticket in the desk for a person. There is nothing to set here.
#
# TXT lookups go over DNS-over-HTTPS. Override only if Google's resolver is
# blocked where the function runs.
# DOH_URL="https://dns.google/resolve"
#
# Where the approval e-mail's "Open the panel" button points. Defaults to
# https://plately.eu.
# SITE_URL="https://plately.eu"
